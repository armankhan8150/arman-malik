# Application
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/arman_malik_backend

# OAuth2 / OpenID Connect
AUTH_ISSUER=https://YOUR_AUTH0_DOMAIN/
AUTH_AUDIENCE=https://YOUR_API_AUDIENCE
AUTH_JWKS_URI=https://YOUR_AUTH0_DOMAIN/.well-known/jwks.json

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# HTTP security
REQUEST_BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=10000

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_IP=20
RATE_LIMIT_CHAT_IP=30
RATE_LIMIT_CHAT_USER=20
RATE_LIMIT_SUBSCRIPTIONS_IP=20
RATE_LIMIT_SUBSCRIPTIONS_USER=10

# Subscription pricing
SUBSCRIPTION_PRICE_BASIC=10
SUBSCRIPTION_PRICE_PRO=25
SUBSCRIPTION_PRICE_ENTERPRISE=100